# ── Server ─────────────────────────────────────────────
# 5000 is used by macOS AirPlay Receiver; 5001 avoids that conflict.
PORT=5001
NODE_ENV=development
# Comma-separated allowed browser origins (dev server + prod preview).
CLIENT_URL=http://localhost:5173,http://localhost:4173

# ── Database ───────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
MONGODB_DB=glim

# ── Auth ───────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ── Platform owner (bootstrap super-admin, used by `npm run seed`) ──
OWNER_EMAIL=owner@yourdomain.com
OWNER_PASSWORD=ChangeMe@123
OWNER_NAME=Platform Owner

# Password assigned to an organization's auto-generated admin@<domain>.
DEFAULT_ORG_ADMIN_PASSWORD=Admin@12345

# ── Email (EmailJS) ────────────────────────────────────
# Get these from https://dashboard.emailjs.com. Enable API for non-browser apps.
MAIL_FROM_NAME="GLIM Portal"
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_PUBLIC_KEY=your_public_key
EMAILJS_PRIVATE_KEY=your_private_key
EMAILJS_TEMPLATE_WELCOME=template_welcome
EMAILJS_TEMPLATE_RESET=template_reset
EMAILJS_TEMPLATE_REMINDER=template_reminder
EMAILJS_TEMPLATE_ASSIGNMENT=template_assignment
EMAILJS_TEMPLATE_GROUP=template_group

REMINDER_LEAD_HOURS=24
