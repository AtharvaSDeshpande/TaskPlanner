# Production mode. For now this points at the SAME local backend so you can test
# the prod build/flow locally. When you stand up a separate prod backend, change
# VITE_API_BASE_URL to its absolute URL (e.g. https://api.glim.example.com/api).
VITE_APP_ENV=production
VITE_API_BASE_URL=http://localhost:5001/api
